# Injected by the Cursor extension, or set manually for standalone MCP:
# VTEX_ACCOUNTS_JSON={"environment":"vtexcommercestable","accounts":{"{account}":{"appKey":"vtexappkey-{account}-XXXXXXXX","appToken":"your-app-token"}}}

# Optional file path when VTEX_ACCOUNTS_JSON is unset (default: ~/.vtex-mcp/accounts.json):
# VTEX_MCP_ACCOUNTS_FILE=C:\Users\you\.vtex-mcp\accounts.json

# Project root for account discovery (FastStore/IO):
# VTEX_MCP_WORKSPACE_ROOT=C:\path\to\your-faststore-or-io-project

# Optional environment override:
# VTEX_ENVIRONMENT=vtexcommercestable

# Legacy single-account env (if no accounts file / JSON):
# VTEX_ACCOUNT={account}
# VTEX_APP_KEY=vtexappkey-{account}-XXXXXXXX
# VTEX_APP_TOKEN=your-app-token
